# proxy-client：本机入口（HTTP/HTTPS + SOCKS5 入站，规则分流 + 出口隧道），
# Ubuntu 22.04 原生部署。
#
# 安装（以 root 执行）：
#   useradd --system --no-create-home --shell /usr/sbin/nologin proxy
#   install -d -o root -g proxy -m 0750 /etc/proxy /etc/proxy/tls
#   install -o root -g proxy -m 0640 client.yaml /etc/proxy/client.yaml   # 明文口令，勿放宽权限
#   install -m 0755 proxy-client /usr/local/bin/proxy-client
#   install -m 0644 proxy-client.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now proxy-client
#   systemctl reload proxy-client      # SIGHUP 热加载（失败保持旧配置）
#   systemd-analyze security proxy-client
#
# 沙箱要点：ProtectSystem=strict/ProtectHome/PrivateTmp 把文件系统收敛为只读+
# 私有临时目录；CapabilityBoundingSet 与 AmbientCapabilities 清空能力集
# （监听 <1024 端口时见文末注释放开 CAP_NET_BIND_SERVICE）；@system-service
# 系统调用过滤 + MemoryDenyWriteExecute（Go 无 JIT，可安全启用）。
[Unit]
Description=Proxy local entry (HTTP/SOCKS5 inbound, rules and exit tunnels)
Documentation=https://github.com/OopsOo0ps/proxy
After=network-online.target
Wants=network-online.target
AssertPathExists=/etc/proxy/client.yaml

[Service]
Type=simple
User=proxy
Group=proxy
ExecStart=/usr/local/bin/proxy-client -config /etc/proxy/client.yaml
# SIGHUP：先校验后原子热加载配置；失败保持旧配置继续服务。
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=1s
SyslogIdentifier=proxy-client
StandardOutput=journal
StandardError=journal

# ---- 沙箱（systemd-analyze security 可复核）----
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
# 监听 <1024 端口（如 DNS 网关 127.0.0.1:53 需 CAP_NET_BIND_SERVICE）时，
# 放开下面两行：
#AmbientCapabilities=CAP_NET_BIND_SERVICE
#CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# 高并发连接需要更大的 fd 上限（与 limits.max_connections 配合）。
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
