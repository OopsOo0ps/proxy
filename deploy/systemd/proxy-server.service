# proxy-server：远端出口（Trojan over TLS），Ubuntu 22.04 原生部署。
#
# 安装见 README「生产部署 → systemd」小节；沙箱配置说明同 proxy-client.service。
[Unit]
Description=Proxy exit node (Trojan over TLS server)
Documentation=https://github.com/OopsOo0ps/proxy
After=network-online.target
Wants=network-online.target
AssertPathExists=/etc/proxy/server.yaml

[Service]
Type=simple
User=proxy
Group=proxy
ExecStart=/usr/local/bin/proxy-server -config /etc/proxy/server.yaml
# SIGHUP：先校验后原子热加载配置；失败保持旧配置继续服务。
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=1s
SyslogIdentifier=proxy-server
StandardOutput=journal
StandardError=journal

# ---- 沙箱（systemd-analyze security 可复核）----
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
# 服务端默认监听 :443（Trojan 惯例端口），仅保留绑定低端口所需的单一能力；
# 若监听高位端口，可清空下面两行换取更小的能力集。
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# 高并发连接需要更大的 fd 上限（与 limits.max_connections 配合）。
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
